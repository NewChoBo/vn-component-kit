{
  "schemaVersion": "2.1.0",
  "readme": "README.md",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "index.js",
      "declarations": [
        {
          "kind": "class",
          "name": "VnButtonElement",
          "description": "Engine-independent icon or text action button.",
          "customElement": true,
          "tagName": "nc-vn-button",
          "attributes": [
            { "name": "variant", "type": { "text": "'icon' | 'text'" }, "default": "text" },
            { "name": "label", "type": { "text": "string" }, "description": "Required accessible and visible label." },
            { "name": "description", "type": { "text": "string" }, "description": "Optional secondary text for the text variant." },
            { "name": "icon", "type": { "text": "string" }, "description": "CSS class tokens required by the icon variant." },
            { "name": "type", "type": { "text": "'button' | 'submit' | 'reset'" }, "default": "button" },
            { "name": "action", "type": { "text": "string" } },
            { "name": "name", "type": { "text": "string" } },
            { "name": "value", "type": { "text": "string" } },
            { "name": "disabled", "type": { "text": "boolean" } }
          ],
          "members": [
            { "kind": "field", "name": "label", "type": { "text": "string" } },
            { "kind": "field", "name": "description", "type": { "text": "string" } },
            { "kind": "field", "name": "disabled", "type": { "text": "boolean" } }
          ],
          "events": [
            {
              "name": "nc-vn-activate",
              "type": { "text": "CustomEvent<{ name: string | null, value: string, action: string | null }>" },
              "description": "Bubbling activation event emitted by the internal native button."
            }
          ]
        },
        {
          "kind": "class",
          "name": "VnChoiceElement",
          "description": "Property-driven choice presentation with two to four options.",
          "customElement": true,
          "tagName": "nc-vn-choice",
          "members": [
            {
              "kind": "field",
              "name": "definition",
              "type": { "text": "VnChoiceDefinition" },
              "description": "Required JavaScript object; JSON string attributes are not accepted."
            }
          ],
          "events": [
            {
              "name": "nc-vn-choice",
              "type": { "text": "CustomEvent<{ definitionId: string, optionId: string }>" },
              "description": "Bubbling event emitted when an enabled option is selected."
            }
          ]
        },
        {
          "kind": "class",
          "name": "VnMemoryGridElement",
          "description": "Engine-independent property-driven memory or replay category list.",
          "customElement": true,
          "tagName": "nc-vn-memory-grid",
          "members": [
            {
              "kind": "field",
              "name": "items",
              "type": { "text": "ReadonlyArray<{ id: string, mark: string, title: string, description: string }>" },
              "description": "Required JavaScript array; JSON string attributes are not accepted."
            }
          ]
        },
        {
          "kind": "class",
          "name": "VnUiScaleElement",
          "description": "Engine-independent compact, standard, or large UI scale selector.",
          "customElement": true,
          "tagName": "nc-vn-ui-scale",
          "attributes": [
            { "name": "value", "type": { "text": "'compact' | 'standard' | 'large'" }, "default": "standard" },
            { "name": "label", "type": { "text": "string" }, "description": "Required visible group label." },
            { "name": "description", "type": { "text": "string" }, "description": "Optional explanation of the setting effect." },
            { "name": "compact-label", "type": { "text": "string" }, "description": "Required localized compact option label." },
            { "name": "standard-label", "type": { "text": "string" }, "description": "Required localized standard option label." },
            { "name": "large-label", "type": { "text": "string" }, "description": "Required localized large option label." },
            { "name": "name", "type": { "text": "string" } },
            { "name": "disabled", "type": { "text": "boolean" } }
          ],
          "members": [
            { "kind": "field", "name": "value", "type": { "text": "'compact' | 'standard' | 'large'" } },
            { "kind": "field", "name": "disabled", "type": { "text": "boolean" } }
          ],
          "events": [
            {
              "name": "nc-vn-ui-scale-change",
              "type": { "text": "CustomEvent<{ name: string | null, value: 'compact' | 'standard' | 'large' }>" },
              "description": "Bubbling event emitted when the selected UI scale changes."
            }
          ]
        },
        {
          "kind": "class",
          "name": "VnViewportGuardElement",
          "description": "Engine-independent viewport classifier that makes sibling UI inert below a configured minimum.",
          "customElement": true,
          "tagName": "nc-vn-viewport-guard",
          "attributes": [
            { "name": "min-short-side", "type": { "text": "number" }, "default": "360" },
            { "name": "min-long-side", "type": { "text": "number" }, "default": "640" },
            { "name": "max-width", "type": { "text": "number" }, "default": "2560" },
            { "name": "max-height", "type": { "text": "number" }, "default": "1440" }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "nc-vn-button",
          "declaration": { "name": "VnButtonElement", "module": "index.js" }
        },
        {
          "kind": "custom-element-definition",
          "name": "nc-vn-choice",
          "declaration": { "name": "VnChoiceElement", "module": "index.js" }
        },
        {
          "kind": "custom-element-definition",
          "name": "nc-vn-memory-grid",
          "declaration": { "name": "VnMemoryGridElement", "module": "index.js" }
        },
        {
          "kind": "custom-element-definition",
          "name": "nc-vn-ui-scale",
          "declaration": { "name": "VnUiScaleElement", "module": "index.js" }
        },
        {
          "kind": "custom-element-definition",
          "name": "nc-vn-viewport-guard",
          "declaration": { "name": "VnViewportGuardElement", "module": "index.js" }
        }
      ]
    }
  ]
}
